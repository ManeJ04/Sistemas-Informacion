<!doctype html>
<html lang="es" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registro de Usuario</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <meta name="theme-color" content="#712cf9" />

    <!-- Estilos de sign-in -->
    <link href="/css/sign-in.css" rel="stylesheet" />
    
    <script src="../assets/js/color-modes.js"></script>
    <style>
      .bd-mode-toggle {
        z-index: 1500;
      }
    </style>
  </head>
  <body class="d-flex align-items-center py-4 bg-body-tertiary">

    <!-- Selector de Tema (Claro / Oscuro / Auto) -->
    <div class="dropdown position-fixed bottom-0 end-0 mb-3 me-3 bd-mode-toggle">
      <button
        class="btn btn-primary py-2 dropdown-toggle d-flex align-items-center"
        id="bd-theme"
        type="button"
        aria-expanded="false"
        data-bs-toggle="dropdown"
        aria-label="Cambiar tema"
      >
        <span class="visually-hidden" id="bd-theme-text">Cambiar tema</span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="bd-theme-text">
        <li>
          <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light">
            Claro
          </button>
        </li>
        <li>
          <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark">
            Oscuro
          </button>
        </li>
        <li>
          <button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="auto">
            Automático
          </button>
        </li>
      </ul>
    </div>

    <!-- Contenedor Principal de Registro -->
    <main class="form-signin w-100 m-auto shadow-sm p-4 rounded bg-body">
      <form action="/register" method="POST">
        
        <div class="text-center mb-4">
          <img
            class="mb-3"
            src="https://getbootstrap.com/docs/5.3/assets/brand/bootstrap-logo.svg"
            alt="Logo"
            width="60"
            height="48"
          />
          <h1 class="h3 mb-1 fw-bold">Crear Cuenta</h1>
          <p class="text-muted small">Regístrate para acceder al sistema</p>
        </div>

        <!-- Campo Nombre -->
        <div class="form-floating mb-2">
          <input type="text" class="form-control" id="name" name="name" placeholder="Tu Nombre" required />
          <label for="name">Nombre Completo</label>
        </div>

        <!-- Campo Email -->
        <div class="form-floating mb-2">
          <input type="email" class="form-control" id="email" name="email" placeholder="nombre@ejemplo.com" required />
          <label for="email">Correo electrónico</label>
        </div>

        <!-- Campo Password -->
        <div class="form-floating mb-3">
          <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required />
          <label for="password">Contraseña</label>
        </div>

        <button class="btn btn-primary w-100 py-2 mb-3 fw-semibold" type="submit">
          Registrarse
        </button>

        <div class="text-center">
          <span class="text-muted small">¿Ya tienes una cuenta?</span>
          <a href="/login" class="text-decoration-none fw-semibold ms-1">Inicia sesión</a>
        </div>

        <p class="mt-4 mb-0 text-center text-body-secondary small">&copy; 2017–2026</p>
      </form>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>