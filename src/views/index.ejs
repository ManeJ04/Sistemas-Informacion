<!doctype html>
<html lang="es" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel Principal - UG</title>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <meta name="theme-color" content="#712cf9" />
    <link href="/css/dashboard.css" rel="stylesheet">
    
    <style>
      .bd-placeholder-img {
        font-size: 1.125rem;
        text-anchor: middle;
        user-select: none;
      }
      .bi {
        vertical-align: -0.125em;
        fill: currentColor;
        width: 1rem;
        height: 1rem;
      }
      .bd-mode-toggle {
        z-index: 1500;
      }
    </style>
  </head>
  <body>
    
    <!-- Navbar Superior -->
    <header class="navbar sticky-top bg-dark flex-md-nowrap p-0 shadow" data-bs-theme="dark">
      <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white fw-bold" href="#">
        UG
      </a>
      
      <!-- Bienvenida del Usuario y Botón de Salida en la barra superior -->
      <div class="navbar-nav flex-row px-3 align-items-center">
        <span class="text-white me-3 d-none d-sm-inline">
          Bienvenido, <strong><%= email.name %></strong>
        </span>
        <a class="btn btn-outline-light btn-sm px-3" href="/logout">
          Cerrar Sesión
        </a>
      </div>

      <button class="navbar-toggler position-absolute d-md-none collapsed border-0 m-2 ms-auto" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </header>

    <div class="container-fluid">
      <div class="row">
        
        <!-- Menú Lateral (Sidebar) -->
        <div class="sidebar border border-right col-md-3 col-lg-2 p-0 bg-body-tertiary">
          <div class="offcanvas-md offcanvas-end bg-body-tertiary" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
            <div class="offcanvas-header">
              <h5 class="offcanvas-title fw-bold" id="sidebarMenuLabel">UG</h5>
              <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close"></button>
            </div>
            
            <div class="offcanvas-body d-md-flex flex-column p-0 pt-lg-3 overflow-y-auto">
              <ul class="nav flex-column">
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2 active" aria-current="page" href="#">
                    <i class="bi bi-house-fill"></i> Inicio
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2" href="#">
                    <i class="bi bi-file-earmark"></i> Pedidos
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2" href="#">
                    <i class="bi bi-cart"></i> Productos
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2" href="/users">
                    <i class="bi bi-people"></i> Lista de Usuarios
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2" href="#">
                    <i class="bi bi-graph-up"></i> Reportes
                  </a>
                </li>
              </ul>

              <hr class="my-3" />

              <ul class="nav flex-column mb-auto">
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2" href="#">
                    <i class="bi bi-gear-wide-connected"></i> Configuración
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2 text-danger" href="/logout">
                    <i class="bi bi-door-closed"></i> Cerrar Sesión
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Contenido Principal -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
          <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <div>
              <h1 class="h2">Panel de Control</h1>
              <p class="text-muted">Sistema de autenticación con JWT y Base de Datos</p>
            </div>
          </div>

          <!-- SECCIÓN PEDIDA POR EL PROFESOR: Datos de la Sesión (JWT) y Actualización de Nombre -->
          <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
              <div class="card shadow-sm h-100">
                <div class="card-body">
                  <h3 class="card-title h5 mb-3 text-primary">👤 Datos de la Sesión (JWT)</h3>
                  <p class="mb-2"><strong>Nombre:</strong> <%= email.name %></p>
                  <p class="mb-2"><strong>Correo:</strong> <%= email.email %></p>
                  <p class="mb-3"><strong>ID de Usuario:</strong> <%= email.id %></p>
                  <span class="badge bg-success">Token Activo y Verificado</span>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card shadow-sm h-100">
                <div class="card-body">
                  <h3 class="card-title h5 mb-3 text-dark">✏️ Actualizar Mi Nombre</h3>
                  <form action="/actualizar" method="POST">
                    <div class="mb-3">
                      <label for="newName" class="form-label small text-muted">Nuevo Nombre</label>
                      <input type="text" class="form-control" id="newName" name="newName" placeholder="Escribe tu nuevo nombre" required>
                    </div>
                    <button type="submit" class="btn btn-dark w-100 fw-semibold">Guardar Cambios</button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <!-- Gráfica de ejemplo -->
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h5 class="card-title mb-3">Estadísticas Generales</h5>
              <canvas class="my-2 w-100" id="myChart" width="900" height="300"></canvas>
            </div>
          </div>

          <!-- Tabla de Datos -->
          <h2 class="h4 mb-3">Registros del Sistema</h2>
          <div class="card shadow-sm">
            <div class="table-responsive small p-3">
              <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                  <tr>
                    <th scope="col"># ID</th>
                    <th scope="col">Concepto</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Estado</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1,001</td>
                    <td>Validación de Token JWT</td>
                    <td>Seguridad</td>
                    <td><span class="badge bg-success">Activo</span></td>
                  </tr>
                  <tr>
                    <td>1,002</td>
                    <td>Conexión con MySQL</td>
                    <td>Base de Datos</td>
                    <td><span class="badge bg-success">Conectado</span></td>
                  </tr>
                  <tr>
                    <td>1,003</td>
                    <td>Cifrado de Contraseñas (Bcrypt)</td>
                    <td>Seguridad</td>
                    <td><span class="badge bg-success">Protegido</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </main>
      </div>
    </div>

    <!-- Scripts de Gráficas -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.3.2/dist/chart.umd.js" integrity="sha384-eI7PSr3L1XLISH8JdDII5YN/njoSsxfbrkCTnJrzXt+ENP5MOVBxD+l6sEG4zoLp" crossorigin="anonymous"></script>
    <script>
      const ctx = document.getElementById('myChart');
      const myChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'],
          datasets: [{
            data: [120, 190, 150, 250, 220, 300, 350],
            lineTension: 0.2,
            backgroundColor: 'transparent',
            borderColor: '#712cf9',
            borderWidth: 3,
            pointBackgroundColor: '#712cf9'
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: false } }
        }
      });
    </script>
  </body>
</html>